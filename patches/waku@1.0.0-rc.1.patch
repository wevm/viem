+// Keeps only the bundle fields `pruneBuildOutput` reads, so chunk code is not
+// retained in memory (or serialized) during static generation.
+const slimBundle = (bundle)=>Object.fromEntries(Object.entries(bundle).map(([key, item])=>[
+            key,
+            item.type === 'chunk' ? {
+                type: item.type,
+                fileName: item.fileName,
+                name: item.name,
+                isEntry: item.isEntry,
+                isDynamicEntry: item.isDynamicEntry,
+                facadeModuleId: item.facadeModuleId,
+                imports: item.imports,
+                dynamicImports: item.dynamicImports,
+                viteMetadata: item.viteMetadata ? {
+                    importedAssets: Array.from(item.viteMetadata.importedAssets ?? []),
+                    importedCss: Array.from(item.viteMetadata.importedCss ?? [])
+                } : undefined
+            } : {
+                type: item.type,
+                fileName: item.fileName
+            }
+        ]));
+// Runs static generation. Exported so it can run in a fresh process after the
+// Vite build exits (see `WAKU_SSG_DEFER_FILE`), releasing bundler memory first.
+export async function runStaticBuild({ rootDir, srcDir, distDir, entryPath, rscBundle }) {
+    const progress = createProgressLogger();
+    const emitFile = async (filePath, body)=>{
+        const destFile = joinPath(rootDir, distDir, filePath);
+        const rel = path.relative(rootDir, destFile);
+        if (!rel || rel.startsWith('..') || path.isAbsolute(rel)) {
+            throw new Error('Invalid filePath: ' + filePath);
+        }
+        progress.update(`generating a file ${pc.dim(filePath)}`);
+        await mkdir(joinPath(destFile, '..'), {
+            recursive: true
+        });
+        await pipeline(Readable.fromWeb(body), fs.createWriteStream(destFile));
+    };
+    console.log(pc.blue('[ssg] processing static generation...'));
+    const startTime = performance.now();
+    const entry = await import(pathToFileURL(entryPath).href);
+    const { prunableFiles } = await entry.INTERNAL_runBuild({
+        rootDir,
+        emitFile
+    });
+    if (prunableFiles.length && rscBundle) {
+        const { stubbedChunks, deletedAssets } = await pruneBuildOutput({
+            rootDir,
+            srcDir,
+            distDir,
+            rscBundle,
+            prunableFiles
+        });
+        console.log(pc.blue(`[prune] removed static-only ${stubbedChunks.length} chunk(s) and ${deletedAssets.length} asset(s) from server bundle`));
+    }
+    progress.done();
+    const fileCount = progress.getCount();
+    console.log(pc.green(`✓ ${fileCount} file${fileCount !== 1 ? 's' : ''} generated in ${Math.ceil(performance.now() - startTime)}ms`));
+}
+// Runs static generation deferred by `WAKU_SSG_DEFER_FILE`.
+export async function runDeferredStaticBuild(file) {
+    await runStaticBuild(JSON.parse(await readFile(file, 'utf8')));
